#!/bin/bash
# Launcher for Scribe Desk.app — finds a tkinter-capable python3 and starts the
# GUI. Works whether the .app stays in the repo or is moved to /Applications or
# the Dock (falls back to the known repo path).
set -uo pipefail

MACOS_DIR="$(cd "$(dirname "$0")" && pwd)"
BUNDLE="$(cd "$MACOS_DIR/../.." && pwd)"

# Prefer the code sitting next to the bundle (app kept in place); otherwise use
# the known repo location so a moved/aliased app still launches.
if [ -f "$BUNDLE/../scribedesk_gui.py" ]; then
    TDIR="$(cd "$BUNDLE/.." && pwd)"
else
    TDIR="$HOME/git/mishandled/scribe-desk"
fi

if [ ! -f "$TDIR/scribedesk_gui.py" ]; then
    /usr/bin/osascript -e 'display alert "Scribe Desk" message "Could not find scribedesk_gui.py. Is the scribe-desk repo still at ~/git/mishandled/scribe-desk?" as critical' >/dev/null 2>&1
    exit 1
fi

# Finder launches with a minimal PATH, so probe absolute interpreters and pick
# the first one that actually has tkinter.
PY=""
for c in /opt/homebrew/bin/python3 /usr/local/bin/python3 /usr/bin/python3; do
    if [ -x "$c" ] && "$c" -c "import tkinter" >/dev/null 2>&1; then
        PY="$c"; break
    fi
done

if [ -z "$PY" ]; then
    /usr/bin/osascript -e 'display alert "Scribe Desk" message "No python3 with tkinter was found. Install python via Homebrew (brew install python-tk) or use the scribe-desk-stt CLI." as critical' >/dev/null 2>&1
    exit 1
fi

cd "$TDIR"
exec "$PY" "$TDIR/scribedesk_gui.py" >>"$TDIR/app-launch.log" 2>&1
